<!doctype html>
<html class="no-js" lang="">
  <head>
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="css/production.css">
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="0" height="0" viewBox="0 0 0 0" style="display: none;">
      <symbol id="svg-grabber" viewBox="0 0 30 30">
        <desc>Icon three horizontal lines with rounded corners</desc>
        <path d="M25,21.52v1.64c0,0.5-0.38,0.92-0.83,0.92H5.83C5.38,24.08,5,23.66,5,23.16v-1.64c0-0.5,0.38-0.92,0.83-0.92h18.33C24.62,20.61,25,21.02,25,21.52L25,21.52z M25,14.18v1.64c0,0.5-0.38,0.92-0.83,0.92H5.83C5.38,16.74,5,16.32,5,15.82v-1.64c0-0.5,0.38-0.92,0.83-0.92h18.33C24.62,13.26,25,13.68,25,14.18L25,14.18z M25,6.84v1.64c0,0.5-0.38,0.92-0.83,0.92H5.83C5.38,9.39,5,8.98,5,8.48V6.84c0-0.5,0.38-0.92,0.83-0.92h18.33C24.62,5.92,25,6.34,25,6.84z"></path>
      </symbol>
    </svg>
    <main class="main">
      <div class="container">
        <div class="layoutBuilderWrapper">
          <div id="js-componentBtnsAside" class="componentBtnsAside">
            <div class="componentTabs">
              <button class="componentTab" data-tab="1">Header</button>
              <button class="componentTab" data-tab="2">Body</button>
              <button class="componentTab" data-tab="3">Footer</button>
            </div>
            <div id="js-componentTabPanels">
              <!-- Buttons will be rendered here by JS -->
            </div>
          </div>
          <div class="columnsWrapper">
            <div id="js-column1" class="column column1"></div>
            <div id="js-column2" class="column column2"></div>
            <div id="js-column3" class="column column3"></div>
            <div id="js-column4" class="column column4"></div>
          </div>
        </div>
      </div>
    </main>
    <script src="./js/sortable.js"></script>
    <script src="./js/development.js"></script>
  </body>
</html>
