<!doctype html>
<html class="no-js" lang="">
  <head>
    <meta charset="utf-8">
    <meta name="description" content="Stock Details Page Builder - Navigate CMS">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Stock Details Page Builder - Navigate CMS</title>
    <link rel="stylesheet" href="css/production.css">
  </head>
  <body>
    <!-- @include "./css/assets/svg-defs.svg" -->
    <main class="main">
      <div class="container">
        <div class="lb-layout-builder-wrapper js-layout-builder-wrapper">
          <div id="js-componentBtnsAside" class="lb-aside-wrapper">
            <div class="lb-aside-tabs">
              <button id="js-componentsTab1" class="js-aside-tab lb-aside-tab" data-tab="1">Header</button>
              <button id="js-componentsTab2" class="js-aside-tab lb-aside-tab" data-tab="2">Column 1</button>
              <button id="js-componentsTab3" class="js-aside-tab lb-aside-tab" data-tab="3">Column 2</button>
              <button id="js-componentsTab4" class="js-aside-tab lb-aside-tab" data-tab="4">Footer</button>
            </div>
            <div id="js-componentTabPane" class="lb-aside-tabs-pane-wrapper">
              <!-- Buttons will be rendered here by JS -->
            </div>
            <div class="lb-aside-actions-wrapper">
              <button id="js-copyConfigBtn" class="lb-aside-actions-btn" title="Copy configuration to clipboard">
                <svg class="icon-aside-copy-config"><use xlink:href="#svg-duplicate"></use></svg>
                Copy Config
              </button>
              <button id="js-clearAllBtn" class="lb-aside-actions-btn btn-danger" title="Remove all components">
                <svg class="icon-aside-clear-all"><use xlink:href="#svg-trash"></use></svg>
                Clear All
              </button>
            </div>
          </div>
          <div class="lb-body-columns-wrapper">
            <div class="lb-body-column-wrapper column-wrapper-1">
              <div class="lb-body-column-heading">Header</div>
              <div id="js-column1" class="lb-body-column-target-wrapper js-body-column-target-wrapper column-target-1 active"></div>
            </div>
            <div class="lb-body-column-wrapper column-wrapper-2">
              <div class="lb-body-column-heading" title="Desktop: Left | Mobile: Stacked Top">Column 1</div>
              <div id="js-column2" class="lb-body-column-target-wrapper js-body-column-target-wrapper column-target-2"></div>
            </div>
            <div class="lb-body-column-wrapper column-wrapper-3">
              <div class="lb-body-column-heading" title="Desktop: Right | Mobile: Stacked Bottom">Column 2</div>
              <div id="js-column3" class="lb-body-column-target-wrapper js-body-column-target-wrapper column-target-3"></div>
            </div>
            <div class="lb-body-column-wrapper column-wrapper-4">
              <div class="lb-body-column-heading">Footer</div>
              <div id="js-column4" class="lb-body-column-target-wrapper js-body-column-target-wrapper column-target-4"></div>
            </div>
          </div>
          <div id="js-componentInfoDrawer" class="lb-aside-info-wrapper hidden">
            <button id="js-closeComponentInfoDrawer" class="lb-aside-info-close-btn">Close</button>
            <h3 class="lb-aside-info-heading">Component Information</h3>
            <div id="js-component-info-content" class="lb-aside-info-text-wrapper js-aside-info-text-wrapper hidden">
              <div class="lb-aside-info-text-item">
                <p class="lb-aside-info-text"></p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </main>
    <script src="./js/sortable.js"></script>
    <script type="module" src="./js/main.js"></script>
  </body>
</html>
