<!doctype html>
<html class="no-js" lang="">
  <head>
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="css/production.css">
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="0" height="0" viewBox="0 0 0 0" style="display: none;">
      <symbol id="svg-grabber" viewBox="0 0 30 30">
        <desc>Icon three horizontal lines with rounded corners</desc>
        <path d="M25,21.52v1.64c0,0.5-0.38,0.92-0.83,0.92H5.83C5.38,24.08,5,23.66,5,23.16v-1.64c0-0.5,0.38-0.92,0.83-0.92h18.33C24.62,20.61,25,21.02,25,21.52L25,21.52z M25,14.18v1.64c0,0.5-0.38,0.92-0.83,0.92H5.83C5.38,16.74,5,16.32,5,15.82v-1.64c0-0.5,0.38-0.92,0.83-0.92h18.33C24.62,13.26,25,13.68,25,14.18L25,14.18z M25,6.84v1.64c0,0.5-0.38,0.92-0.83,0.92H5.83C5.38,9.39,5,8.98,5,8.48V6.84c0-0.5,0.38-0.92,0.83-0.92h18.33C24.62,5.92,25,6.34,25,6.84z"></path>
      </symbol>
      <symbol id="svg-circle-plus" viewBox="0 0 20 20">
        <desc>Icon of a Plus Symbol in a Circle</desc>
        <circle cx="10" cy="10" r="10"/>
        <polygon points="14.4,9.5 10.5,9.5 10.5,5.9 9.5,5.9 9.5,9.5 5.6,9.5 5.6,10.5 9.5,10.5 9.5,14.1 10.5,14.1 10.5,10.5 14.4,10.5" fill="currentColor"/>
      </symbol>
      <symbol id="svg-circle-minus" viewBox="0 0 35 35">
        <desc>Icon of circle with minus inside</desc>
        <path d="M24.7,18.7H10.3v-2.5h14.4V18.7z M17.5,5.3c-6.7,0-12.2,5.5-12.2,12.2s5.5,12.2,12.2,12.2s12.2-5.5,12.2-12.2S24.2,5.3,17.5,5.3 M17.5,2.3c8.4,0,15.2,6.8,15.2,15.2c0,8.4-6.8,15.2-15.2,15.2S2.3,25.9,2.3,17.5C2.3,9.1,9.1,2.3,17.5,2.3L17.5,2.3z"/>
      </symbol>
      <symbol id="svg-info-circle" viewBox="0 0 30 30">
        <desc>icon of letter i in a filled circle</desc>
        <path d="M15,4.8C9.3,4.8,4.8,9.3,4.8,15S9.3,25.2,15,25.2S25.2,20.7,25.2,15S20.7,4.8,15,4.8z M16.2,11.4h-2.4V9h2.4V11.4z M16.2,21h-2.4v-7.2h2.4V21z"/>
      </symbol>
    </svg>
    <main class="main">
      <div class="container">
        <div class="layoutBuilderWrapper">
          <div id="js-componentBtnsAside" class="componentBtnsAside">
            <div class="componentsTabs">
              <button id="js-componentsTab1" class="componentsTab" data-tab="1">Header</button>
              <button id="js-componentsTab2" class="componentsTab" data-tab="2">Body</button>
              <button id="js-componentsTab3" class="componentsTab" data-tab="3">Footer</button>
            </div>
            <div id="js-componentTabPane" class="componentTabPane">
              <!-- Buttons will be rendered here by JS -->
            </div>
          </div>
          <div class="columnsWrapper">
            <div id="js-column1" class="column column1 active"></div>
            <div id="js-column2" class="column column2"></div>
            <div id="js-column3" class="column column3"></div>
            <div id="js-column4" class="column column4"></div>
          </div>
          <div id="js-componentInfoDrawer" class="componentInfoAside hidden">
            <button id="js-closeComponentInfoDrawer" class="closeDrawerBtn">Close</button>
            <h3 class="componentInfoHeading">Component Information</h3>
            <div id="js-component1-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Stock Heading</strong> component.</p>
              </div>
            </div>
            <div id="js-component2-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Stock Price</strong> component.</p>
              </div>
            </div>
            <div id="js-component3-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Reserve Now</strong> component.</p>
              </div>
            </div>
            <div id="js-component4-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Mystery</strong> component.</p>
              </div>
            </div>
            <div id="js-component5-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Image Carousel</strong> component.</p>
              </div>
            </div>
            <div id="js-component6-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <label class="imRadioLabel" for="formRadio1">
                  <input type="radio" name="formSelection" id="formRadio1" value="1">
                  Basic Enquiry Form
                </label>
                <label class="imRadioLabel" for="formRadio2">
                  <input type="radio" name="formSelection" id="formRadio2" value="2">
                  Book a Service Form
                </label>
                <label class="imRadioLabel" for="formRadio3">
                  <input type="radio" name="formSelection" id="formRadio3" value="3">
                  Book a Test Drive Form
                </label>
                <label class="imRadioLabel" for="formRadio4">
                  <input type="radio" name="formSelection" id="formRadio4" value="4">
                  Finance Form
                </label>
                <label class="imRadioLabel" for="formRadio5">
                  <input type="radio" name="formSelection" id="formRadio5" value="5">
                  Fleet Form
                </label>
                <label class="imRadioLabel" for="formRadio6">
                  <input type="radio" name="formSelection" id="formRadio6" value="6">
                  Get a Quote Form
                </label>
                <label class="imRadioLabel" for="formRadio7">
                  <input type="radio" name="formSelection" id="formRadio7" value="7">
                  Make an Offer Form
                </label>
                <label class="imRadioLabel" for="formRadio8">
                  <input type="radio" name="formSelection" id="formRadio8" value="8">
                  Trade In Enquiry Form
                </label>
              </div>
            </div>
            <div id="js-component7-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Form</strong> component.</p>
              </div>
            </div>
            <div id="js-component8-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>CTAs</strong> component.</p>
              </div>
            </div>
            <div id="js-component9-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Key Features</strong> component.</p>
              </div>
            </div>
            <div id="js-component10-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Dealer Location</strong> component.</p>
              </div>
            </div>
            <div id="js-component11-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Dealer Comments</strong> component.</p>
              </div>
            </div>
            <div id="js-component12-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Specifications</strong> component.</p>
              </div>
            </div>
            <div id="js-component13-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Disclaimer</strong> component.</p>
              </div>
            </div>
            <div id="js-component14-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Stock Specials</strong> component.</p>
              </div>
            </div>
            <div id="js-component15-information" class="componentInfo hidden">
              <div class="componentInfoTextWrapper">
                <p>There is currently no information available for the <strong>Similar Vehicles</strong> component.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </main>
    <script src="./js/sortable.js"></script>
    <script src="./js/development.js"></script>
  </body>
</html>
